# Copy this file to .env and fill in your own values.
# .env is never committed to git and is loaded automatically on startup.

# ---- Server ----
PORT=3000
NODE_ENV=production
SESSION_SECURE=false

# ---- Admin account ----
# Created automatically the first time the server starts.
# Change the password here any time to reset it (delete data/admin.json first).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=StrongPassword!2025

# Long random string used to sign login sessions. Change this to any long
# random text before going live (e.g. generate one at randomkeygen.com).
SESSION_SECRET=e4b96817f5b2a13d8f2acbe53cf51fd6d1948ed1d48b5c0f

# ---- Site branding & contact info (shown on the public site) ----
SITE_NAME=Lumiere Parfums
SITE_TAGLINE=Authentic imported fragrances, curated for you
CURRENCY_SYMBOL=$

# WhatsApp number customers tap to order, digits only with country code,
# e.g. 15551234567 for +1 555 123 4567. Leave blank to hide the button.
WHATSAPP_NUMBER=

CONTACT_EMAIL=hello@example.com
CONTACT_PHONE=+1 (000) 000-0000
ADDRESS=Your City, Your Country

# Optional social links. Leave blank to hide.
INSTAGRAM_URL=
TELEGRAM_URL=
FACEBOOK_URL=
